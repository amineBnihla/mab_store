# Neon Postgres connection string.
# Neon dashboard -> your project -> Connection Details -> "Connection string".
# Use the pooled host for the app; drizzle-kit works with either.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin Better Auth runs on. Set to the deployed URL in production.
BETTER_AUTH_URL="http://localhost:3000"

# Same origin, exposed to the browser for the Better Auth client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
